# Copie este arquivo para .env.local e preencha com os valores do SEU projeto.
# IMPORTANTE:
#  - NUNCA comite o arquivo .env.local (já está no .gitignore).
#  - A SERVICE_ROLE_KEY é um segredo de servidor: jamais use prefixo NEXT_PUBLIC_ nela
#    e jamais a exponha no navegador. É lida apenas no servidor (lib/supabaseServer.ts).

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key

# --- Proteção de acesso (senha única) ---
# Senha compartilhada para entrar no dashboard (tela /login).
# Em desenvolvimento pode ficar em branco (acesso liberado).
# Na Vercel (produção) é OBRIGATÓRIA — sem ela o app bloqueia o acesso.
ACCESS_PASSWORD=defina_uma_senha_forte
